# Google Apps Script Web App URL
# Apps Script > Deploy > New Deployment > Web App kimi deploy et
NEXT_PUBLIC_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Google Sheets URL (Sidebar-da link göstərmək üçün, ixtiyari)
NEXT_PUBLIC_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# Groq API Key — pulsuz: https://console.groq.com → API Keys → Create key
GROQ_API_KEY=gsk_...
